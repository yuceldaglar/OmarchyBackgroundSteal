<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OmarchyBackgrounds_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12">
        <TextBlock
            FontSize="20"
            FontWeight="SemiBold"
            Text="Omarchy Backgrounds" />
        <TextBlock
            Opacity="0.8"
            Text="Slice 2: pick a local image and apply to desktop + lock screen."
            TextWrapping="WrapWholeWords" />
        <Button
            x:Name="ApplyButton"
            Click="ApplyLocalImage_Click"
            Content="Apply local image…" />
        <TextBlock
            x:Name="StatusText"
            Text="Ready."
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</Page>
