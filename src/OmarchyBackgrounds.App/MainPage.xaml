<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OmarchyBackgrounds_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OmarchyBackgrounds_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:catalog="using:OmarchyBackgrounds.Catalog"
    xmlns:history="using:OmarchyBackgrounds.ApplyHistory"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.ColumnSpan="3"
            FontSize="22"
            FontWeight="SemiBold"
            Text="Omarchy Backgrounds" />

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Opacity="0.85"
            Text="Loading catalog…"
            TextWrapping="WrapWholeWords" />

        <Grid Grid.Row="2" Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="140" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontWeight="SemiBold" Text="Themes" />
            <ListView
                x:Name="ThemeList"
                Grid.Row="1"
                SelectionChanged="ThemeList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="catalog:Theme">
                        <TextBlock Text="{x:Bind Name}" TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                Grid.Row="2"
                FontWeight="SemiBold"
                Text="Recent" />
            <ListView
                x:Name="RecentList"
                Grid.Row="3"
                SelectionChanged="RecentList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="history:AppliedThemeEntry">
                        <TextBlock Text="{x:Bind Name}" TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button
                x:Name="RefreshButton"
                Grid.Row="4"
                HorizontalAlignment="Stretch"
                Click="RefreshButton_Click"
                Content="Refresh catalog" />
        </Grid>

        <Grid Grid.Row="2" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock FontWeight="SemiBold" Text="Backgrounds" />
            <GridView
                x:Name="BackgroundGrid"
                Grid.Row="1"
                SelectionChanged="BackgroundGrid_SelectionChanged">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:BackgroundItemVm">
                        <Border
                            Width="168"
                            Height="112"
                            Margin="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4">
                            <Grid>
                                <Image
                                    Stretch="UniformToFill"
                                    Source="{x:Bind Thumbnail, Mode=OneWay}" />
                                <Border
                                    Padding="6,4"
                                    VerticalAlignment="Bottom"
                                    Background="#99000000">
                                    <TextBlock
                                        Foreground="White"
                                        Text="{x:Bind FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <StackPanel Grid.Row="2" Grid.Column="2" Spacing="12">
            <TextBlock FontWeight="SemiBold" Text="Preview" />
            <Border
                Height="180"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="4">
                <Image x:Name="PreviewImage" Stretch="UniformToFill" />
            </Border>
            <TextBlock
                x:Name="AttributionText"
                Opacity="0.85"
                Text="Select a background"
                TextWrapping="WrapWholeWords" />
            <HyperlinkButton
                x:Name="SourceLink"
                Content="Open theme source"
                NavigateUri="https://omarchy.org/themes/" />
            <Button
                x:Name="ApplyDesktopButton"
                HorizontalAlignment="Stretch"
                Click="ApplyDesktopButton_Click"
                Content="Apply desktop"
                IsEnabled="False" />
            <Button
                x:Name="ApplyLockScreenButton"
                HorizontalAlignment="Stretch"
                Click="ApplyLockScreenButton_Click"
                Content="Apply lock screen"
                IsEnabled="False" />
            <Button
                x:Name="ApplyBothButton"
                HorizontalAlignment="Stretch"
                Click="ApplyBothButton_Click"
                Content="Apply both"
                IsEnabled="False" />
        </StackPanel>

        <TextBlock
            Grid.Row="3"
            Grid.ColumnSpan="3"
            Opacity="0.6"
            Text="Source: omarchy.org/themes — wallpapers belong to their theme authors."
            TextWrapping="WrapWholeWords" />
    </Grid>
</Page>
